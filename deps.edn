{:paths ["src" "resources"]

 ;; Zero runtime dependencies beyond Clojure itself: R2 is reached by signing
 ;; requests with AWS Signature V4 (com.heavycomputation.cloudflare.internal.*)
 ;; and sending them over the JDK's built-in java.net.http client.
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}}

 :aliases
 {;; Run the test suite:  clojure -X:test
  :test
  {:extra-paths ["test"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  ;; Live R2 round-trip against a real bucket (needs CLOUDFLARE_* env vars):
  ;;   clojure -X:integration
  ;; Kept separate from :test so CI stays offline.
  :integration
  {:extra-paths ["test-integration"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn     cognitect.test-runner.api/test
   :exec-args   {:dirs ["test-integration"]}}

  ;; Build / install / deploy the jar:  clojure -T:build jar
  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.5"}
                slipset/deps-deploy           {:mvn/version "0.2.2"}}
   :ns-default build}

  ;; REPL for development:  clojure -M:dev
  :dev
  {:extra-paths ["test" "dev"]}}}
